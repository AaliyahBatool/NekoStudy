{
  "name": "nekostudy",
  "private": true,
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "build": "pnpm --filter @nekostudy/shared build && pnpm --filter @nekostudy/api build && pnpm --filter @nekostudy/web build",
    "dev": "pnpm --parallel -r dev",
    "typecheck": "pnpm --filter @nekostudy/shared build && pnpm --filter @nekostudy/api typecheck && pnpm --filter @nekostudy/web typecheck",
    "lint": "eslint . --ext .js,.mjs,.cjs,.ts,.tsx",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm --filter @nekostudy/api test && pnpm --filter @nekostudy/web test",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.9",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.2",
    "prettier": "^3.10.1",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.74.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css,html}": "prettier --write"
  }
}
